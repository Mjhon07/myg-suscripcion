# Copia este archivo a .env y completa los valores
# Render: DB_DRIVER=sqlite (no necesita MySQL)
# Docker local: DB_DRIVER=mysql y DB_HOST=db (ver docker-compose.yml)
# InfinityFree: DB_DRIVER=mysql + Hostname/DB del panel

DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=myg_db
DB_USER=root
DB_PASSWORD=

APP_NAME="MYG - Suscripción de Entretenimiento"
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost:8080

SESSION_NAME=MYG_session
