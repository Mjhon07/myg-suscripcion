# Copia este archivo a .env y completa los valores
# Docker: usa DB_HOST=db (ver docker-compose.yml)
# InfinityFree: usa el Hostname y Database name del panel

DB_HOST=localhost
DB_PORT=3306
DB_NAME=myg_db
DB_USER=root
DB_PASSWORD=

APP_NAME="MYG - Suscripción de Entretenimiento"
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost:8080

SESSION_NAME=MYG_session
